# Keep source and configuration files consistent across Windows and Linux.
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf

# Documents and compiled artifacts must never receive line-ending conversion.
*.pdf binary
*.docx binary
*.exe binary
